<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Online Assessment</title>

<style>

/* =========================
   GLOBAL
========================= */

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f3f5f8;
    color: #222;
}


/* =========================
   REGISTRATION PAGE
========================= */

#registrationPage {
    min-height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;

    background: linear-gradient(
        135deg,
        #172b4d,
        #31558a
    );
}

.registration-box {
    width: 430px;
    max-width: 90%;

    background: white;

    padding: 35px;

    border-radius: 12px;

    box-shadow:
        0 15px 40px rgba(0,0,0,0.25);
}

.registration-box h1 {
    text-align: center;

    color: #172b4d;

    margin-bottom: 8px;
}

.registration-box p {
    text-align: center;

    color: #666;

    margin-bottom: 30px;
}

.form-group {
    margin-bottom: 18px;
}

.form-group label {
    display: block;

    font-weight: bold;

    margin-bottom: 7px;
}

.form-group input,
.form-group select {

    width: 100%;

    padding: 13px;

    border: 1px solid #ccc;

    border-radius: 6px;

    font-size: 16px;
}

.form-group input:focus,
.form-group select:focus {

    outline: none;

    border-color: #31558a;
}

.start-btn {

    width: 100%;

    padding: 14px;

    border: none;

    border-radius: 6px;

    background: #31558a;

    color: white;

    font-size: 17px;

    font-weight: bold;

    cursor: pointer;
}

.start-btn:hover {

    background: #172b4d;
}

.error {

    color: #d32f2f;

    text-align: center;

    margin-bottom: 15px;

    display: none;
}


/* =========================
   TEST PAGE
========================= */

#testPage {
    display: none;
}


/* =========================
   HEADER
========================= */

.header {

    height: 65px;

    background: #172b4d;

    color: white;

    display: flex;

    justify-content: space-between;

    align-items: center;

    padding: 0 25px;
}

.logo {

    font-size: 21px;

    font-weight: bold;
}

.timer {

    background: white;

    color: #d32f2f;

    padding: 10px 18px;

    border-radius: 6px;

    font-weight: bold;

    min-width: 90px;

    text-align: center;
}


/* =========================
   MAIN
========================= */

.main {

    display: flex;

    height: calc(100vh - 65px);
}


/* =========================
   SIDEBAR
========================= */

.sidebar {

    width: 280px;

    background: white;

    border-right: 1px solid #ddd;

    padding: 20px;

    overflow-y: auto;
}

.candidate {

    border-bottom: 1px solid #ddd;

    padding-bottom: 18px;

    margin-bottom: 20px;
}

.candidate-name {

    font-size: 17px;

    font-weight: bold;

    margin-top: 7px;
}

.roll {

    color: #666;

    margin-top: 5px;
}

.section-title {

    font-weight: bold;

    margin: 20px 0 10px;
}

.section {

    padding: 12px;

    margin: 6px 0;

    border-radius: 5px;

    background: #f2f4f7;
}

.section.active {

    background: #172b4d;

    color: white;
}


/* =========================
   QUESTION PALETTE
========================= */

.palette {

    display: grid;

    grid-template-columns:
        repeat(5, 1fr);

    gap: 8px;
}

.palette button {

    height: 35px;

    border: 1px solid #ccc;

    background: white;

    cursor: pointer;

    border-radius: 4px;

    font-weight: bold;
}

.palette button.answered {

    background: #43a047;

    color: white;
}

.palette button.review {

    background: #7e57c2;

    color: white;
}

.palette button.current {

    border: 3px solid #172b4d;
}


/* =========================
   LEGEND
========================= */

.legend {

    margin-top: 20px;

    font-size: 13px;
}

.legend div {

    margin: 8px 0;
}

.box {

    width: 15px;

    height: 15px;

    display: inline-block;

    vertical-align: middle;

    margin-right: 6px;

    border-radius: 2px;
}

.green {
    background: #43a047;
}

.purple {
    background: #7e57c2;
}

.white {

    background: white;

    border: 1px solid #aaa;
}


/* =========================
   CONTENT
========================= */

.content {

    flex: 1;

    padding: 25px;

    overflow-y: auto;
}

.top-info {

    background: white;

    padding: 15px 20px;

    border-radius: 7px;

    margin-bottom: 20px;

    display: flex;

    justify-content: space-between;
}

.question-card {

    background: white;

    padding: 30px;

    border-radius: 8px;

    min-height: 400px;
}

.question-number {

    color: #666;

    margin-bottom: 15px;
}

.question {

    font-size: 20px;

    font-weight: bold;

    line-height: 1.5;

    margin-bottom: 25px;
}


/* =========================
   OPTIONS
========================= */

.option {

    display: block;

    padding: 15px;

    margin: 12px 0;

    border: 1px solid #ddd;

    border-radius: 7px;

    cursor: pointer;
}

.option:hover {

    background: #f0f5ff;
}

.option.selected {

    background: #e8f0fe;

    border: 2px solid #31558a;
}

.option input {

    margin-right: 12px;
}


/* =========================
   NAVIGATION
========================= */

.navigation {

    background: white;

    margin-top: 20px;

    padding: 15px;

    display: flex;

    gap: 10px;

    flex-wrap: wrap;
}

.navigation button {

    padding: 12px 20px;

    border: none;

    border-radius: 5px;

    cursor: pointer;

    font-weight: bold;
}

.previous {

    background: #e0e0e0;
}

.next {

    background: #31558a;

    color: white;
}

.review-btn {

    background: #7e57c2;

    color: white;
}

.clear-btn {

    background: #eeeeee;
}

.submit-container {

    margin-top: 20px;

    text-align: right;
}

.submit {

    padding: 14px 35px;

    background: #2e7d32;

    color: white;

    border: none;

    border-radius: 6px;

    font-size: 16px;

    font-weight: bold;

    cursor: pointer;
}

.submit:hover {

    background: #1b5e20;
}


/* =========================
   RESULT PAGE
========================= */

#result {

    display: none;

    max-width: 850px;

    margin: 40px auto;

    background: white;

    padding: 40px;

    border-radius: 10px;

    text-align: center;

    box-shadow:
        0 10px 30px rgba(0,0,0,0.1);
}

#result h1 {

    color: #172b4d;

    margin-bottom: 10px;
}

.result-candidate {

    background: #f5f7fa;

    padding: 15px;

    border-radius: 7px;

    margin: 20px 0;
}

.score {

    font-size: 50px;

    color: #31558a;

    font-weight: bold;

    margin: 20px 0;
}

.percentage {

    font-size: 25px;

    color: #2e7d32;

    font-weight: bold;
}

.result-table {

    width: 100%;

    border-collapse: collapse;

    margin-top: 25px;
}

.result-table th,
.result-table td {

    padding: 12px;

    border: 1px solid #ddd;
}

.result-table th {

    background: #172b4d;

    color: white;
}


/* =========================
   ANSWER REVIEW
========================= */

#answerReview {

    margin-top: 35px;

    text-align: left;
}

#answerReview h2 {

    text-align: center;

    color: #172b4d;

    margin-bottom: 20px;
}

.answer-card {

    padding: 18px;

    margin-bottom: 15px;

    border-radius: 7px;

    border-left: 6px solid;
}

.answer-card h3 {

    margin-top: 0;
}

.answer-card p {

    line-height: 1.5;
}

.correct-card {

    background: #e8f5e9;

    border-left-color: #2e7d32;
}

.wrong-card {

    background: #ffebee;

    border-left-color: #d32f2f;
}

.unanswered-card {

    background: #fff8e1;

    border-left-color: #ff9800;
}

.your-answer {

    color: #333;
}

.correct-answer {

    color: #2e7d32;

    font-weight: bold;
}

.status {

    font-weight: bold;

    font-size: 16px;
}


/* =========================
   MOBILE
========================= */

@media(max-width: 700px) {

    .header {

        padding: 0 12px;
    }

    .logo {

        font-size: 15px;
    }

    .main {

        flex-direction: column;

        height: auto;
    }

    .sidebar {

        width: 100%;
    }

    .content {

        padding: 15px;
    }

    .top-info {

        flex-direction: column;

        gap: 10px;
    }

    .navigation {

        flex-direction: column;
    }

    .navigation button {

        width: 100%;
    }

    .submit-container {

        text-align: center;
    }

    .submit {

        width: 100%;
    }

    #result {

        margin: 15px;

        padding: 20px;
    }

    .result-table {

        font-size: 14px;
    }

    .question {

        font-size: 18px;
    }
}

</style>
</head>


<body>


<!-- =====================================================
     REGISTRATION PAGE
===================================================== -->

<div id="registrationPage">

    <div class="registration-box">

        <h1>Online Assessment</h1>

        <p>
            Candidate Registration
        </p>


        <div
            id="errorMessage"
            class="error"
        >
            Please fill all details.
        </div>


        <!-- NAME -->

        <div class="form-group">

            <label for="studentName">
                Full Name
            </label>

            <input
                type="text"
                id="studentName"
                placeholder="Enter your full name"
            >

        </div>


        <!-- ROLL NUMBER -->

        <div class="form-group">

            <label for="rollNumber">
                Roll Number
            </label>

            <input
                type="text"
                id="rollNumber"
                placeholder="Enter your roll number"
            >

        </div>


        <!-- SECTION -->

        <div class="form-group">

            <label for="studentSection">
                Section
            </label>

            <select id="studentSection">

                <option value="">
                    Select Section
                </option>

                <option value="A">
                    Section A
                </option>

                <option value="B">
                    Section B
                </option>

                <option value="C">
                    Section C
                </option>

                <option value="D">
                    Section D
                </option>

            </select>

        </div>


        <button
            class="start-btn"
            onclick="startTest()"
        >
            Start Test →
        </button>

    </div>

</div>



<!-- =====================================================
     TEST PAGE
===================================================== -->

<div id="testPage">

    <!-- HEADER -->

    <div class="header">

        <div class="logo">
            ONLINE ASSESSMENT
        </div>

        <div class="timer">

            ⏱
            <span id="timer">
                60:00
            </span>

        </div>

    </div>


    <div class="main">


        <!-- SIDEBAR -->

        <aside class="sidebar">


            <div class="candidate">

                <div>
                    Candidate
                </div>

                <div
                    class="candidate-name"
                    id="displayName"
                >
                </div>

                <div
                    class="roll"
                    id="displayRoll"
                >
                </div>

                <div
                    class="roll"
                    id="displaySection"
                >
                </div>

            </div>


            <div class="section-title">
                Test Section
            </div>


            <div class="section active">
                Python & Aptitude
            </div>


            <div class="section-title">
                Question Palette
            </div>


            <div
                class="palette"
                id="palette"
            >
            </div>


            <div class="legend">

                <div>

                    <span
                        class="box green"
                    ></span>

                    Answered

                </div>


                <div>

                    <span
                        class="box purple"
                    ></span>

                    Marked for Review

                </div>


                <div>

                    <span
                        class="box white"
                    ></span>

                    Not Answered

                </div>

            </div>

        </aside>



        <!-- QUESTION AREA -->

        <main class="content">


            <div class="top-info">

                <span>

                    Section:

                    <strong>
                        Python & Aptitude
                    </strong>

                </span>


                <span>

                    Question

                    <strong
                        id="questionNumber"
                    >
                        1
                    </strong>

                    of

                    <strong
                        id="totalQuestions"
                    >
                        10
                    </strong>

                </span>

            </div>



            <div class="question-card">


                <div class="question-number">

                    Question

                    <span id="qNo">
                        1
                    </span>

                </div>


                <div
                    class="question"
                    id="question"
                >
                </div>


                <div id="options">
                </div>


            </div>



            <div class="navigation">


                <button
                    class="previous"
                    onclick="previousQuestion()"
                >
                    ← Previous
                </button>


                <button
                    class="review-btn"
                    onclick="markReview()"
                >
                    🔖 Mark for Review
                </button>


                <button
                    class="clear-btn"
                    onclick="clearAnswer()"
                >
                    Clear Response
                </button>


                <button
                    class="next"
                    onclick="nextQuestion()"
                >
                    Save & Next →
                </button>


            </div>



            <div class="submit-container">

                <button
                    class="submit"
                    onclick="submitTest()"
                >
                    Submit Test
                </button>

            </div>


        </main>

    </div>

</div>



<!-- =====================================================
     RESULT PAGE
===================================================== -->

<div id="result">


    <h1>
        🎉 Test Completed
    </h1>


    <p>
        Your test has been submitted successfully.
    </p>


    <!-- CANDIDATE -->

    <div class="result-candidate">

        <strong>
            Candidate:
        </strong>

        <span id="resultName">
        </span>


        <br><br>


        <strong>
            Roll No:
        </strong>

        <span id="resultRoll">
        </span>


        <br><br>


        <strong>
            Section:
        </strong>

        <span id="resultSection">
        </span>

    </div>



    <!-- SCORE -->

    <div class="score">

        <span id="finalScore">
            0
        </span>

        /

        <span id="resultTotal">
            10
        </span>

    </div>


    <div class="percentage">

        Percentage:

        <span id="percentage">
            0%
        </span>

    </div>



    <!-- RESULT TABLE -->

    <table class="result-table">

        <tr>

            <th>
                Total Questions
            </th>

            <td id="totalResult">
                10
            </td>

        </tr>


        <tr>

            <th>
                Attempted
            </th>

            <td id="attempted">
                0
            </td>

        </tr>


        <tr>

            <th>
                Correct
            </th>

            <td id="correct">
                0
            </td>

        </tr>


        <tr>

            <th>
                Wrong
            </th>

            <td id="wrong">
                0
            </td>

        </tr>


        <tr>

            <th>
                Not Attempted
            </th>

            <td id="notAttempted">
                0
            </td>

        </tr>

    </table>



    <!-- ANSWER REVIEW -->

    <div id="answerReview">

    </div>



    <br>


    <button
        class="submit"
        onclick="location.reload()"
    >
        Take Test Again
    </button>


</div>



<script>


/* =====================================================
   QUESTION BANK
===================================================== */

const questions = [

    {
        question:
        "Which keyword is used for a conditional statement in Python?",

        options: [
            "for",
            "if",
            "def",
            "loop"
        ],

        answer: 1
    },


    {
        question:
        "What is the output of print(10 > 5)?",

        options: [
            "10",
            "5",
            "True",
            "False"
        ],

        answer: 2
    },


    {
        question:
        "Which operator checks equality in Python?",

        options: [
            "=",
            "==",
            "!=",
            "=>"
        ],

        answer: 1
    },


    {
        question:
        "What is 25% of 240?",

        options: [
            "40",
            "50",
            "60",
            "80"
        ],

        answer: 2
    },


    {
        question:
        "A train travels 120 km in 2 hours. What is its average speed?",

        options: [
            "40 km/h",
            "50 km/h",
            "60 km/h",
            "80 km/h"
        ],

        answer: 2
    },


    {
        question:
        "What is the next number: 2, 4, 8, 16, ?",

        options: [
            "20",
            "24",
            "32",
            "36"
        ],

        answer: 2
    },


    {
        question:
        "Which data type represents True or False in Python?",

        options: [
            "String",
            "Integer",
            "Boolean",
            "Float"
        ],

        answer: 2
    },


    {
        question:
        "If x + 10 = 25, what is x?",

        options: [
            "10",
            "15",
            "20",
            "25"
        ],

        answer: 1
    },


    {
        question:
        "Which symbol starts a comment in Python?",

        options: [
            "//",
            "#",
            "/*",
            "--"
        ],

        answer: 1
    },


    {
        question:
        "Which keyword is used to define a function in Python?",

        options: [
            "function",
            "define",
            "def",
            "fun"
        ],

        answer: 2
    }

];



/* =====================================================
   VARIABLES
===================================================== */

let studentName = "";

let rollNumber = "";

let studentSection = "";

let currentQuestion = 0;

let answers = [];

let reviewQuestions = [];

let timeLeft = 60 * 60;

let timer;



/* =====================================================
   START TEST
===================================================== */

function startTest() {


    studentName =
        document.getElementById(
            "studentName"
        ).value.trim();


    rollNumber =
        document.getElementById(
            "rollNumber"
        ).value.trim();


    studentSection =
        document.getElementById(
            "studentSection"
        ).value;


    const error =
        document.getElementById(
            "errorMessage"
        );


    if (
        studentName === "" ||
        rollNumber === "" ||
        studentSection === ""
    ) {

        error.style.display =
            "block";

        return;
    }


    error.style.display =
        "none";


    /* Candidate information */

    document.getElementById(
        "displayName"
    ).textContent =
        studentName;


    document.getElementById(
        "displayRoll"
    ).textContent =
        "Roll No: " +
        rollNumber;


    document.getElementById(
        "displaySection"
    ).textContent =
        "Section: " +
        studentSection;


    /* Reset */

    currentQuestion = 0;


    answers =
        new Array(
            questions.length
        ).fill(null);


    reviewQuestions =
        new Array(
            questions.length
        ).fill(false);


    timeLeft = 60 * 60;


    document.getElementById(
        "totalQuestions"
    ).textContent =
        questions.length;


    createPalette();


    document.getElementById(
        "registrationPage"
    ).style.display =
        "none";


    document.getElementById(
        "testPage"
    ).style.display =
        "block";


    showQuestion();

    startTimer();

}



/* =====================================================
   CREATE PALETTE
===================================================== */

function createPalette() {


    const palette =
        document.getElementById(
            "palette"
        );


    palette.innerHTML = "";


    questions.forEach(
        (_, index) => {


            const button =
                document.createElement(
                    "button"
                );


            button.textContent =
                index + 1;


            button.onclick =
                function() {

                    currentQuestion =
                        index;

                    showQuestion();

                };


            palette.appendChild(
                button
            );

        }
    );

}



/* =====================================================
   SHOW QUESTION
===================================================== */

function showQuestion() {


    const q =
        questions[currentQuestion];


    document.getElementById(
        "questionNumber"
    ).textContent =
        currentQuestion + 1;


    document.getElementById(
        "qNo"
    ).textContent =
        currentQuestion + 1;


    document.getElementById(
        "question"
    ).textContent =
        q.question;


    const options =
        document.getElementById(
            "options"
        );


    options.innerHTML = "";


    q.options.forEach(
        (option, index) => {


            const label =
                document.createElement(
                    "label"
                );


            label.className =
                "option";


            if (
                answers[currentQuestion]
                === index
            ) {

                label.classList.add(
                    "selected"
                );

            }


            label.innerHTML = `

                <input
                    type="radio"
                    name="answer"
                    ${
                        answers[currentQuestion]
                        === index
                        ? "checked"
                        : ""
                    }
                >

                ${option}

            `;


            label.onclick =
                function() {

                    answers[
                        currentQuestion
                    ] = index;

                    showQuestion();

                };


            options.appendChild(
                label
            );

        }
    );


    updatePalette();

}



/* =====================================================
   UPDATE PALETTE
===================================================== */

function updatePalette() {


    const buttons =
        document.querySelectorAll(
            ".palette button"
        );


    buttons.forEach(
        (button, index) => {


            button.className = "";


            if (
                answers[index] !== null
            ) {

                button.classList.add(
                    "answered"
                );

            }


            if (
                reviewQuestions[index]
            ) {

                button.classList.add(
                    "review"
                );

            }


            if (
                index === currentQuestion
            ) {

                button.classList.add(
                    "current"
                );

            }

        }
    );

}



/* =====================================================
   NEXT QUESTION
===================================================== */

function nextQuestion() {


    if (
        currentQuestion <
        questions.length - 1
    ) {

        currentQuestion++;

        showQuestion();

    }

}



/* =====================================================
   PREVIOUS QUESTION
===================================================== */

function previousQuestion() {


    if (
        currentQuestion > 0
    ) {

        currentQuestion--;

        showQuestion();

    }

}



/* =====================================================
   MARK FOR REVIEW
===================================================== */

function markReview() {


    reviewQuestions[
        currentQuestion
    ] =
        !reviewQuestions[
            currentQuestion
        ];


    updatePalette();

}



/* =====================================================
   CLEAR RESPONSE
===================================================== */

function clearAnswer() {


    answers[
        currentQuestion
    ] = null;


    showQuestion();

}



/* =====================================================
   TIMER
===================================================== */

function startTimer() {


    clearInterval(timer);


    timer =
        setInterval(
            function() {


                timeLeft--;


                updateTimer();


                if (
                    timeLeft <= 0
                ) {


                    clearInterval(
                        timer
                    );


                    alert(
                        "Time is over. Your test will be submitted automatically."
                    );


                    submitTest(true);

                }


            },
            1000
        );


    updateTimer();

}



function updateTimer() {


    const minutes =
        Math.floor(
            timeLeft / 60
        );


    const seconds =
        timeLeft % 60;


    document.getElementById(
        "timer"
    ).textContent =

        String(minutes)
        .padStart(2, "0")

        + ":"

        +

        String(seconds)
        .padStart(2, "0");

}



/* =====================================================
   SUBMIT TEST
===================================================== */

function submitTest(
    automatic = false
) {


    /* Confirmation */

    if (!automatic) {


        const confirmSubmit =
            confirm(
                "Are you sure you want to submit the test?"
            );


        if (!confirmSubmit) {

            return;

        }

    }


    clearInterval(timer);


    /* Result variables */

    let correct = 0;

    let wrong = 0;

    let attempted = 0;

    let notAttempted = 0;



    /* Calculate */

    questions.forEach(
        (question, index) => {


            const selected =
                answers[index];


            if (
                selected === null
            ) {

                notAttempted++;

            }

            else {


                attempted++;


                if (
                    selected ===
                    question.answer
                ) {

                    correct++;

                }

                else {

                    wrong++;

                }

            }

        }
    );



    const total =
        questions.length;


    const percentage =
        (
            correct / total
        ) * 100;



    /* =================================================
       PUT RESULT DATA ON PAGE
    ================================================= */


    document.getElementById(
        "resultName"
    ).textContent =
        studentName;


    document.getElementById(
        "resultRoll"
    ).textContent =
        rollNumber;


    document.getElementById(
        "resultSection"
    ).textContent =
        studentSection;


    document.getElementById(
        "finalScore"
    ).textContent =
        correct;


    document.getElementById(
        "resultTotal"
    ).textContent =
        total;


    document.getElementById(
        "percentage"
    ).textContent =
        percentage.toFixed(2)
        + "%";


    document.getElementById(
        "totalResult"
    ).textContent =
        total;


    document.getElementById(
        "attempted"
    ).textContent =
        attempted;


    document.getElementById(
        "correct"
    ).textContent =
        correct;


    document.getElementById(
        "wrong"
    ).textContent =
        wrong;


    document.getElementById(
        "notAttempted"
    ).textContent =
        notAttempted;



    /* =================================================
       ANSWER REVIEW
    ================================================= */

    const answerReview =
        document.getElementById(
            "answerReview"
        );


    answerReview.innerHTML = `

        <h2>
            Answer Review
        </h2>

    `;



    questions.forEach(
        (question, index) => {


            const selected =
                answers[index];


            const correctAnswer =
                question.answer;


            let cardClass = "";

            let status = "";


            /* Not attempted */

            if (
                selected === null
            ) {

                cardClass =
                    "unanswered-card";

                status =
                    "⚠️ Not Attempted";

            }


            /* Correct */

            else if (
                selected ===
                correctAnswer
            ) {

                cardClass =
                    "correct-card";

                status =
                    "✅ Correct";

            }


            /* Wrong */

            else {

                cardClass =
                    "wrong-card";

                status =
                    "❌ Wrong";

            }



            const yourAnswer =
                selected === null
                ? "Not Attempted"
                : question.options[selected];


            const correctAnswerText =
                question.options[
                    correctAnswer
                ];



            const card =
                document.createElement(
                    "div"
                );


            card.className =
                "answer-card "
                + cardClass;



            card.innerHTML = `

                <h3>
                    Question ${index + 1}
                </h3>

                <p>
                    <strong>
                        ${question.question}
                    </strong>
                </p>

                <p class="your-answer">

                    <strong>
                        Your Answer:
                    </strong>

                    ${yourAnswer}

                </p>

                <p class="correct-answer">

                    <strong>
                        Correct Answer:
                    </strong>

                    ${correctAnswerText}

                </p>

                <p class="status">

                    ${status}

                </p>

            `;


            answerReview.appendChild(
                card
            );

        }
    );



    /* =================================================
       CHANGE TO RESULT PAGE
    ================================================= */

    document.getElementById(
        "testPage"
    ).style.display =
        "none";


    document.getElementById(
        "result"
    ).style.display =
        "block";


    /* Go to top */

    window.scrollTo(
        0,
        0
    );

}

</script>

